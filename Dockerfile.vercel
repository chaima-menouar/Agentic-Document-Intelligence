FROM node:22-bookworm-slim AS frontend
WORKDIR /src/frontend
COPY frontend/package*.json ./
RUN npm ci
COPY frontend/ ./
ENV VITE_MAX_PDF_BYTES=4194304 VITE_MAX_UPLOAD_BYTES=4194304
RUN npm run build

FROM python:3.12-slim
ENV PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1 PORT=8501 ADI_MAX_PDF_BYTES=4194304 ADI_MAX_UPLOAD_BYTES=4194304 ADI_AUDIO_ENABLED=1 ADI_WHISPER_MODEL=tiny
WORKDIR /app
RUN apt-get update && apt-get install -y --no-install-recommends tesseract-ocr libgomp1 && rm -rf /var/lib/apt/lists/*
COPY requirements.txt requirements-web.txt requirements-retrieval.txt requirements-ocr.txt requirements-audio.txt ./
RUN pip install --no-cache-dir torch --index-url https://download.pytorch.org/whl/cpu
RUN pip install --no-cache-dir -r requirements.txt -r requirements-web.txt -r requirements-retrieval.txt -r requirements-ocr.txt -r requirements-audio.txt
RUN python -c "from faster_whisper import WhisperModel; WhisperModel('tiny', device='cpu', compute_type='int8')"
COPY app ./app
COPY --from=frontend /src/frontend/dist ./frontend/dist
EXPOSE 8501
CMD ["sh","-c","python -m uvicorn app.web.api:app --host 0.0.0.0 --port ${PORT:-8501} --workers 1"]
